# Supabase (create a free project at https://supabase.com)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Gemini (AI question generator) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Admin panel password (simple gate for the teacher dashboard)
ADMIN_PASSWORD=YOUR_TEACHER_PASSWORD

# Supabase service-role key — SERVER SIDE ONLY, never expose in the browser.
# Used by the /api serverless functions. Find it in:
# Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
